#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/icons/app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @IVY_VERSION_MAJOR@,@IVY_VERSION_MINOR@,@IVY_VERSION_PATCH@,0
PRODUCTVERSION  @IVY_VERSION_MAJOR@,@IVY_VERSION_MINOR@,@IVY_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Ivynote"
            VALUE "FileDescription",  "Ivynote"
            VALUE "FileVersion",      "@IVY_VERSION@"
            VALUE "InternalName",     "ivynote"
            VALUE "OriginalFilename", "ivynote.exe"
            VALUE "ProductName",      "Ivynote"
            VALUE "ProductVersion",   "@IVY_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
